---
import figlet from 'figlet'
import devsync from '@core'
import { defaultLang } from '@core'
import { translations, type availableLangsType } from '@core'
import ProjectCard from '@/components/project-card.astro'

const lang = (
  Astro.params.lang || defaultLang
).toLowerCase() as availableLangsType
const profile = devsync[lang] ?? devsync[defaultLang]
const projects = profile.projects ?? []
const translation = translations[lang]

const titleText = translation['Projects']
const asciiTitle = figlet
  .textSync(titleText, {
    font: 'ANSI Regular',
    width: 80,
    whitespaceBreak: true,
  })
  .trimStart()
---

{
  projects.length > 0 && (
    <section id="projects" class="relative m-auto w-full max-w-4xl px-6 py-16">
      <div class="border-border mb-12 flex items-end justify-between border-b pb-4">
        <div>
          <pre
            class="text-accent font-mono text-xl tracking-widest"
            set:html={asciiTitle}
          />
        </div>
        <span class="text-text-secondary/50 font-mono text-xs">
          {projects.length} project{projects.length > 1 ? 's' : ''}
        </span>
      </div>

      <div class="space-y-12">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>
  )
}
