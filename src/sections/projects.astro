---
import devsync from '@core'
import { defaultLang } from '@core'
import { translations, type availableLangsType } from '@core'
import ProjectCard from '@/components/project-card.astro'

const lang = (
  Astro.params.lang || defaultLang
).toLowerCase() as availableLangsType
const profile = devsync[lang] ?? devsync[defaultLang]
const projects = profile.projects ?? []
const translation = translations[lang]
---

{
  projects.length > 0 && (
    <section id="projects" class="m-auto mt-15 w-full max-w-4xl px-6">
      <div class="mb-8 flex items-center justify-between">
        <span class="text-accent font-mono text-xs font-bold tracking-widest uppercase">
          {translation['SYSTEM_LOG']}: {translation['Projects']}
        </span>
        <span class="text-text-secondary/50 font-mono text-xs uppercase">
          {translation['FILTER']}: {translation['ALL_TIME']}
        </span>
      </div>
      <hr class="border-border mb-8" />

      <div class="space-y-12">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>
  )
}
