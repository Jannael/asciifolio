---
import { translations, type availableLangsType } from '@core'
import devsync, { defaultLang, getLangData } from '@core'
import SectionHeader from '@/components/section-header.astro'

const lang = (Astro.params.lang || defaultLang).toLowerCase() as availableLangsType
const profile = getLangData(devsync, lang)
const education = profile.education ?? []
const translation = translations[lang]
---

{
  education.length > 0 && (
    <section id="education" class="m-auto w-full max-w-4xl px-6 py-16">
      <SectionHeader title={translation['Education']} />

      <ul>
        {education.map((edu, i) => (
          <li>
            <div class="border-accent/30 border-l-2 pl-6">
              <div class="mb-2 flex flex-col sm:flex-row sm:items-start sm:justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-accent text-sm">■</span>
                  <h3 class="text-accent text-lg font-bold">
                    {edu.degree}
                    {edu.name && (
                      <>
                        {' '}
                        <span class="text-text-secondary/50 font-normal">@</span>{' '}
                        <span class="text-accent">{edu.name}</span>
                      </>
                    )}
                  </h3>
                </div>
                {edu.date && (
                  <span class="text-text-secondary/60 shrink-0 font-mono text-xs">
                    [{edu.date}]
                  </span>
                )}
              </div>

              {edu.list?.items?.length && (
                <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                  {edu.list.items.map((item, idx) => (
                    <div class="border-border border p-3">
                      <p class="text-accent mb-2 font-mono text-xs font-bold tracking-wider uppercase">
                        &gt;&gt; {item.highlight}
                      </p>
                      {item.description && (
                        <p class="text-text-secondary text-xs leading-relaxed">
                          {item.description}
                        </p>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {edu.links?.length && (
                <div class="flex flex-wrap gap-3">
                  {edu.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-text-secondary hover:text-accent inline-flex items-center gap-1.5 text-xs font-medium underline underline-offset-4 transition-colors"
                    >
                      {link.icon && (
                        <img src={link.icon} alt={link.name} class="inline h-3.5 w-3.5" />
                      )}
                      {link.name}
                      <span class="text-accent/60">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </div>

            {i < education.length - 1 && <hr class="border-border/30 my-6" />}
          </li>
        ))}
      </ul>
    </section>
  )
}
