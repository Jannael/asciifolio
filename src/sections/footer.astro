---
import devsync from '@core'

const fullName = devsync.name ?? 'Portfolio'
const year = new Date().getFullYear()
const socialMedia = devsync.socialMedia ?? []
---

<footer class="border-border mt-20 border-t">
  <div class="m-auto w-full max-w-4xl px-6 py-8">
    <div class="mb-6 overflow-hidden">
      <pre
        id="pacman-anim"
        class="text-accent/40 font-mono text-xs leading-none"
        aria-hidden="true"
        style="min-height: 1.2em;">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . </pre>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 sm:justify-start">
        <span class="text-text-secondary text-sm">{year} {fullName}</span>
        <span class="text-text-secondary/30">·</span>
        <span class="text-text-secondary text-sm">Built with Devsync</span>
      </div>

      {
        socialMedia.length > 0 && (
          <div class="flex flex-wrap items-center gap-5">
            {socialMedia.slice(0, 3).map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-secondary hover:text-accent text-sm underline underline-offset-4 transition-colors"
              >
                {social.name}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</footer>

<script lang="ts">
  ;(function () {
    const pre = document.getElementById('pacman-anim')
    if (!pre) return

    const WIDTH = 60
    const PACMAN_OPEN = 'C'
    const PACMAN_CLOSED = '>'
    const GHOST = 'M'
    const DOT = '.'
    const PELLET = '*'

    const dots = Array.from({ length: WIDTH }, () => DOT)
    dots[15] = PELLET
    dots[30] = PELLET
    dots[45] = PELLET

    const ghostPositions = [12, 25, 38, 50]
    let pacmanPos = 0
    const SPEED = 6
    let tick = 0
    let frame = 0
    const eatenGhosts = new Set()
    const eatenDots = new Set()

    function render() {
      const row = [...dots]

      for (const gp of ghostPositions) {
        if (!eatenGhosts.has(gp)) {
          row[gp] = GHOST
        }
      }

      for (const dp of eatenDots) {
        row[dp] = ' '
      }

      const mouth = frame % 8 < 4 ? PACMAN_OPEN : PACMAN_CLOSED
      row[pacmanPos] = mouth

      pre.textContent = row.join('')
    }

    function update() {
      tick++

      if (tick % SPEED === 0) {
        if (dots[pacmanPos] === DOT && !eatenDots.has(pacmanPos)) {
          eatenDots.add(pacmanPos)
        }

        if (dots[pacmanPos] === PELLET && !eatenDots.has(pacmanPos)) {
          eatenDots.add(pacmanPos)
          eatenGhosts.clear()
        }

        for (const gp of ghostPositions) {
          if (pacmanPos === gp) {
            eatenGhosts.add(gp)
          }
        }

        const prevPos = pacmanPos
        pacmanPos = (pacmanPos + 1) % WIDTH

        if (pacmanPos === 0 && prevPos === WIDTH - 1) {
          eatenDots.clear()
          eatenGhosts.clear()
          for (let i = 0; i < WIDTH; i++) {
            if (dots[i] === DOT || dots[i] === PELLET) {
              dots[i] = dots[i] === PELLET ? PELLET : DOT
            }
          }
        }
      }

      frame++
      render()
      requestAnimationFrame(update)
    }

    render()
    requestAnimationFrame(update)
  })()
</script>
