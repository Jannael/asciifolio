---
import Badge from '@/components/badge.astro'
import AsciiFigure from '@/components/ascii-figure.astro'
import AsciiScramble from '@/components/ascii-scramble.astro'
import devsync from '@core'
import { defaultLang } from '@core'
import { translations, type availableLangsType } from '@core'
import figlet from 'figlet'
import LangSwitcher from '@/sections/lang-switcher.astro'
import ThemeSwitcher from '@/sections/theme-switcher.astro'

const lang = (
  Astro.params.lang || defaultLang
).toLowerCase() as availableLangsType
const profile = devsync[lang] ?? devsync[defaultLang]
const translation = translations[lang]
const firstName = devsync.name?.split(' ')[0] || 'DEV'

const asciiArt = await figlet.text(firstName, {
  font: 'ANSI Regular',
  horizontalLayout: 'default',
  verticalLayout: 'default',
  width: 80,
  whitespaceBreak: true,
})

const asciiLines = asciiArt.split('\n').filter((line) => line.trim() !== '')
const socialMedia = devsync.socialMedia ?? []
---

<section class="m-auto mt-10 w-full max-w-4xl px-4 sm:px-6">
  <div class="terminal-window rounded-xl">
    <div
      class="bg-surface-bright border-border text-text-secondary flex items-center gap-2 rounded-tl-xl rounded-tr-xl border border-b px-4 py-3 text-xs select-none"
    >
      <span class="text-accent font-bold">&gt;</span>
      <span class="min-w-0 flex-1 truncate"
        >{translation['TERMINAL_TITLE']}</span
      >
      <div class="flex items-center gap-2">
        <LangSwitcher currentLang={lang} class="text-xs" />
        <ThemeSwitcher />
      </div>
    </div>

    <div class="terminal-content border-border border p-4 sm:p-8">
      <div
        class="relative mb-5 flex items-center justify-between gap-4 max-sm:flex-col max-sm:items-center"
      >
        <div
          class="flex-1 overflow-x-hidden overflow-y-hidden"
          style={`min-height: ${asciiLines.length * 1}rem;`}
        >
          <AsciiFigure class="text-accent sm:text-lg md:text-xl">
            <AsciiScramble lines={asciiLines} />
          </AsciiFigure>
        </div>
        {
          devsync.img && (
            <div class="shrink-0">
              <div class="relative">
                <div class="bg-accent/30 absolute -inset-1 rounded-full blur-md" />
                <img
                  src={devsync.img}
                  alt={devsync.name}
                  class="border-accent relative z-10 h-20 w-20 rounded-full border-2 object-cover sm:h-24 sm:w-24"
                  width="96"
                  height="96"
                  loading="eager"
                />
              </div>
            </div>
          )
        }
      </div>

      <div class="border-border/50 border-t border-dashed pt-6">
        <h2
          class="text-text-secondary font-mono text-sm tracking-[0.2em] uppercase max-sm:text-center sm:text-base"
        >
          {profile.jobTitle}
        </h2>

        <div
          class="mt-6 flex items-center justify-between gap-3 max-sm:flex-col max-sm:items-stretch"
        >
          <div
            class="flex flex-wrap items-center gap-3 max-sm:w-full max-sm:flex-col"
          >
            {
              socialMedia.map((social) => (
                <Badge
                  name={social.name}
                  url={social.url}
                  icon={social.icon}
                  class="max-sm:w-full max-sm:justify-center"
                />
              ))
            }
            <Badge
              name={translation['CV']}
              url={'/CV-' + lang + '.pdf'}
              icon="/icons/cv.svg"
              class="max-sm:w-full max-sm:justify-center"
            />
          </div>
          {
            profile.status?.status && (
              <span class="border-accent/40 text-accent flex shrink-0 items-center gap-2 rounded border px-4 py-2 font-mono text-xs tracking-wider uppercase max-sm:w-full max-sm:justify-center">
                <span class="bg-accent inline-block h-2 w-2 animate-pulse rounded-full shadow-[0_0_10px_var(--color-accent)]" />
                {translation['Status']}: {profile.status.status}
              </span>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .terminal-window {
    box-shadow:
      0 0 30px color-mix(in srgb, var(--color-accent) 15%, transparent),
      inset 0 0 80px color-mix(in srgb, var(--color-accent) 5%, transparent);
  }
</style>
