---
import Badge from '@/components/badge.astro'
import AsciiFigure from '@/components/ascii-figure.astro'
import AsciiScramble from '@/components/ascii-scramble.astro'
import devsync from '@core'
import { defaultLang } from '@core'
import { type availableLangsType } from '@/devsync/fields-translations'
import figlet from 'figlet'

const lang = (
  Astro.params.lang || defaultLang
).toLowerCase() as availableLangsType
const profile = devsync[lang] ?? devsync[defaultLang]
const firstName = devsync.name?.split(' ')[0] || 'DEV'

const asciiArt = await figlet.text(firstName, {
  font: 'ANSI Regular',
  horizontalLayout: 'default',
  verticalLayout: 'default',
  width: 80,
  whitespaceBreak: true,
})

const asciiLines = asciiArt.split('\n')
const socialMedia = devsync.socialMedia ?? []
---

<section class="m-auto mt-10 w-full max-w-4xl px-6">
  <div class="terminal-window border-border border">
    <div
      class="bg-surface-bright border-border text-text-secondary flex items-center gap-2 border-b px-4 py-3 text-xs select-none"
    >
      <span class="text-accent font-bold">&gt;</span>
      <span class="flex-1">C:\DEV\PORTFOLIO.EXE</span>
    </div>

    <div class="relative p-8">
      <div class="relative">
        {
          devsync.img && (
            <div class="absolute top-0 right-0 z-10">
              <div class="relative">
                <div class="bg-accent/30 absolute -inset-1 rounded-full blur-md" />
                <img
                  src={devsync.img}
                  alt={devsync.name}
                  class="border-accent relative z-10 h-20 w-20 rounded-full border-2 object-cover sm:h-24 sm:w-24"
                  width="96"
                  height="96"
                  loading="eager"
                />
              </div>
            </div>
          )
        }

        <div
          class="overflow-x-auto"
          style={`min-height: ${asciiLines.length * 1.5}rem;`}
        >
          <AsciiFigure class="text-accent sm:text-lg md:text-xl">
            <AsciiScramble lines={asciiLines} />
          </AsciiFigure>
        </div>
      </div>

      <div class="border-border/50 border-t border-dashed pt-6">
        <h2
          class="text-text-secondary font-mono text-sm tracking-[0.2em] uppercase sm:text-base"
        >
          {profile.jobTitle}
        </h2>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          {
            socialMedia.map((social) => (
              <Badge name={social.name} url={social.url} icon={social.icon} />
            ))
          }
          <Badge name="CV" url={'/CV-' + lang + '.pdf'} icon="/icons/cv.svg" />
        </div>

        {
          profile.status?.status && (
            <div class="mt-6 flex justify-end">
              <span class="border-accent/40 text-accent inline-flex items-center gap-2 rounded border px-4 py-2 font-mono text-xs tracking-wider uppercase">
                <span class="bg-accent inline-block h-2 w-2 animate-pulse rounded-full shadow-[0_0_10px_var(--color-accent)]" />
                STATUS: {profile.status.status}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .terminal-window {
    box-shadow:
      0 0 30px color-mix(in srgb, var(--color-accent) 15%, transparent),
      inset 0 0 80px color-mix(in srgb, var(--color-accent) 5%, transparent);
  }
</style>
