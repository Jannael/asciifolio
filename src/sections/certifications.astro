---
import { translations, type availableLangsType } from '@core'
import devsync, { defaultLang } from '@core'

const lang = (
  Astro.params.lang || defaultLang
).toLowerCase() as availableLangsType
const profile = devsync[lang] ?? devsync[defaultLang]
const certifications = profile.certifications ?? []
const translation = translations[lang]
---

{
  certifications.length > 0 && (
    <section id="certifications" class="m-auto w-full max-w-4xl px-6">
      <div class="border-accent mb-8 border-t-2 bg-main/50 px-4 py-3">
        <div class="flex items-center justify-between">
          <span class="text-accent font-mono text-sm font-bold tracking-wider uppercase">
            {translation['SYSTEM_LOG']}: {translation['Certifications']}
          </span>
          <span class="text-text-secondary/50 font-mono text-xs uppercase">
            {translation['FILTER']}: {translation['ALL_TIME']}
          </span>
        </div>
      </div>

      <ul>
        {certifications.map((cert, i) => (
          <li>
            <div class="border-accent/30 border-l-2 pl-6">
              <div class="mb-2 flex items-start justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-accent text-sm">■</span>
                  <h3 class="text-accent text-lg font-bold">
                    {cert.name}
                  </h3>
                </div>
                {cert.url && (
                  <a
                    href={cert.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-secondary hover:text-accent inline-flex items-center gap-1.5 text-xs font-medium underline underline-offset-4 transition-colors"
                  >
                    {translation['View Certificate']}
                    <span class="text-accent/60">↗</span>
                  </a>
                )}
              </div>

              {cert.list?.items?.length && (
                <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                  {cert.list.items.map((item, idx) => (
                    <div class="border-border border p-3">
                      <p class="text-accent mb-2 font-mono text-xs font-bold tracking-wider uppercase">
                        &gt;&gt; {item.highlight}
                      </p>
                      {item.description && (
                        <p class="text-text-secondary text-xs leading-relaxed">
                          {item.description}
                        </p>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {cert.skills?.length && (
                <p class="text-text-secondary/50 font-mono text-xs">
                  {translation['STACK']}:{' '}
                  {cert.skills.map((s, idx) => (
                    <span>
                      {idx > 0 && (
                        <span class="text-text-secondary/30"> · </span>
                      )}
                      {s.name}
                    </span>
                  ))}
                </p>
              )}
            </div>

            {i < certifications.length - 1 && <hr class="border-border/30 my-6" />}
          </li>
        ))}
      </ul>
    </section>
  )
}