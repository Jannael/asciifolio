---
interface Props {
  title: string
  filter?: string
}

const { title, filter = 'ALL_TIME' } = Astro.props
---

<div class="border-border bg-main/30 mb-8 border-b-2 px-4 py-3">
  <div class="flex items-center justify-between">
    <span
      class="text-accent font-mono text-sm font-bold tracking-wider uppercase sm:text-xl"
    >
      <span class="mr-2">■■■</span>
      SYSTEM_LOG: {title}
    </span>
    <span class="text-text-secondary/50 font-mono text-xs uppercase">
      FILTER: {filter}
    </span>
  </div>
</div>
