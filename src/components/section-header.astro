---
interface Props {
  title: string
  filter?: string
}

const { title, filter = 'ALL_TIME' } = Astro.props
---

<div class="border-border bg-main/30 mb-8 border-b-2 px-4 py-3">
  <div class="flex flex-wrap items-center justify-between gap-1">
    <span
      class="text-accent min-w-0 truncate font-mono text-sm font-bold tracking-wider uppercase sm:text-xl"
    >
      <span class="mr-2 shrink-0">■■■</span>
      <span class="truncate">SYSTEM_LOG: {title}</span>
    </span>
    <span class="text-text-secondary/50 shrink-0 font-mono text-xs uppercase">
      FILTER: {filter}
    </span>
  </div>
</div>
