---
interface Props {
  name?: string
  img?: string
  web?: string
  links?: {
    name?: string
    url?: string
    mdBadge?: string
    icon?: string
  }[]
  description?: string
  list?: {
    title?: string
    items?: {
      highlight?: string
      description?: string
    }[]
  }
  skills?: {
    name?: string
    mdBadge?: string
    icon?: string
  }[]
}

const { name, img, web, links, description, list, skills } = Astro.props
---

<div class="border-border group bg-main/30 relative border p-6">
  <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
    <div class="flex-1">
      <h3 class="text-text text-xl font-bold lg:text-2xl">
        {name}
      </h3>
      {
        web && (
          <a
            href={web}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary/60 hover:text-accent font-mono text-xs transition-colors"
          >
            {web.replace(/^https?:\/\//, '')}
          </a>
        )
      }
      {
        links?.length && (
          <div class="mt-3 flex flex-wrap gap-3">
            {links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="border-text-secondary/40 hover:border-accent hover:text-accent inline-flex items-center gap-1.5 border px-3 py-1.5 text-xs font-medium tracking-wide uppercase transition-colors"
              >
                {link.name}
                <span class="text-accent/60">↗</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
    {
      img && (
        <img
          src={img}
          alt={name ?? 'Project preview'}
          class="border-border h-20 w-20 rounded-lg border object-cover opacity-60 transition-opacity group-hover:opacity-90"
          width="80"
          height="80"
        />
      )
    }
  </div>

  {description && <p class="text-text-secondary mb-6 text-sm leading-relaxed">{description}</p>}

  {
    list?.items?.length ? (
      <div class="mb-6 grid gap-4 sm:grid-cols-2">
        {list.items.map((item) => (
          <div class="border-border bg-main/50 border p-4">
            <div class="text-accent mb-2 font-mono text-xs">
              {'>>'} {item.highlight}
            </div>
            {item.description && (
              <p class="text-text-secondary text-xs leading-relaxed">{item.description}</p>
            )}
          </div>
        ))}
      </div>
    ) : null
  }

  {
    skills?.length && (
      <span class="text-text-secondary/50 font-mono text-xs">
        STACK: {skills.map((s) => s.name).join(' · ')}
      </span>
    )
  }
</div>
