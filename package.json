{
	"name": "@devsync/template",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"build:preview": "node scripts/copy-preview && bunx @jannael/devsync build && node scripts/move-cv-pdfs.js && git reset --hard && git clean -fd",
		"preview": "astro preview",
		"astro": "astro",
		"deploy": "bun run build:preview && wrangler pages deploy",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.3",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/roboto": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.2.0",
		"figlet": "1.11.4",
		"sharp": "0.35.3",
		"tailwindcss": "4.3.3",
		"zod": "4.4.3"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devsync": {},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"eslint": "10.8.1",
		"eslint-plugin-astro": "3.1.0",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript-eslint": "8.66.0",
		"wrangler": "4.120.0"
	}
}
