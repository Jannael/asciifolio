{
  "name": "@devsync/template",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "node scripts/copy-preview && bunx @jannael/devsync build && node scripts/move-cv-pdfs.js && git reset --hard && git clean -fd",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "deploy": "bun run build:preview && wrangler pages deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.2",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/roboto": "5.2.10",
    "@tailwindcss/vite": "4.3.0",
    "astro": "6.3.7",
    "figlet": "1.11.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.3.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devsync": {
    "pathToCompiledCV": "./dist/[lang]/cv/index.html"
  },
  "lint-staged": {
    "*.{astro,js,ts,mjs}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "oxlint": "1.66.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "wrangler": "4.94.0"
  }
}
